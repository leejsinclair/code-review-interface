  "telemetryInstanceId": "d9c9c93a-ffb9-4c5f-927e-7e585cf1e724",
  "assistant": "claude",
  "approach": "A pure classifier in core/risk runs when a snapshot is stored and writes append-only rule records; a separate AI lane can only raise a class and must cite a resolvable changed line; overrides are append-only Dispositions carried across snapshots by a change fingerprint, with the platform identity read server-side through a new currentUser() contract method. The effective class is derived, never stored.",
  "decisions": [
    {
      "decision": "Rule file uses globs and literal line terms, not regexes",
      "why": "A user-edited file cannot cause catastrophic backtracking and needs no new dependency",
      "rejected": "Regex line patterns; YAML rule file",
      "by": "agent",
      "at": "2026-11-10T03:52:35.707Z"
    },
    {
      "decision": "Overrides carry over by a fingerprint of the file's changed lines, not head commit",
      "why": "An unrelated new head must not lapse an override on an unchanged file",
      "rejected": "head commit; whole-diff fingerprint",
      "by": "agent",
      "at": "2026-11-10T03:52:35.840Z"
    },
    {
      "decision": "Separate risk lane and risk_run table with its own context columns",
      "why": "Risk must not queue behind summaries, and stored_prompt owner CHECK would need an append-only table rebuild",
      "rejected": "Share the summary lane; extend stored_prompt",
      "by": "agent",
      "at": "2026-11-10T03:52:35.956Z"
    },
