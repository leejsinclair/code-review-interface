  "decisions": [
    {
      "decision": "Find the enclosing project repo by nearest ancestor folder among discovered clones",
      "why": "Discovery already records nested clones; no platform or naming knowledge needed (VIII.2)",
      "rejected": "Naming convention or configured mapping"
    },
    {
      "decision": "Read other branches with allowlisted ls-remote, fetch into refs/prwb spec-N, ls-tree, log -1",
      "why": "Same safety shape as the PR fetch; no working copy change (IX)",
      "rejected": "Reading the reviewer refs, or a platform file API"
    },
    {
      "decision": "One AI run on a new alignment lane returns summaries, rows, verdict and deviations",
      "why": "Rows need both documents and the diff together; one record, no disagreement",
      "rejected": "Separate runs, or reusing the summary lane"
    },
    {
      "decision": "Store full document text and downgrade unresolvable citations rather than drop them",
      "why": "Citations stay openable after a branch moves; dropped findings read as clean (V.1)",
      "rejected": "Re-reading from git on demand"
    },
    {
      "decision": "One alignment run uses the first key with a found specification; its parts sit under that key",
      "why": "data-model.md ties a run to one specification document",
      "rejected": "one run per key"
    },
    {
      "decision": "Refresh re-reads the documents and compares a signature rather than only ls-remote",
      "why": "simplest way to detect a moved commit or a new matching branch",
      "rejected": "ls-remote plus last-commit checks only"
    },
    {
      "decision": "Added a commitTime git command and own-repository-first to the stored rule enum",
      "why": "chooseCopy needs commit dates and the own-repository rule has no stored value",
      "rejected": "leaving the rule lossy"
    },
    {
      "decision": "The overview file list was removed; its risk-badge tests were ported to the Diff screen",
      "why": "FR-007",
      "rejected": "keeping both"
    }
